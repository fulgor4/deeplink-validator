#!/bin/sh
# Clone-and-run launcher: ./deeplink-trace '<url>' [--paths-only] [--json] ...   (run with --help for options)
# Prefers Bun (its fetch honours HTTP(S)_PROXY), falls back to Node 18+.
export NODE_USE_ENV_PROXY=1  # Node >= 22.21 / 24 then honours HTTP(S)_PROXY (ignored by older Node and by Bun)
here=$(cd "$(dirname "$0")" && pwd)
script="$here/cli/deeplink-trace.mjs"
if command -v bun >/dev/null 2>&1; then exec bun "$script" "$@"
elif [ -x "$HOME/.local/bin/bun" ]; then exec "$HOME/.local/bin/bun" "$script" "$@"
elif command -v node >/dev/null 2>&1; then exec node "$script" "$@"
else echo "deeplink-trace: needs Node 18+ (or Bun) on PATH" >&2; exit 127; fi
